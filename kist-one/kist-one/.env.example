# Copy this file to .env for local development (and never commit the real .env).
# On Vercel, set these as Project → Settings → Environment Variables instead.

# From Supabase project settings → API.
SUPABASE_URL=https://gigitazwycombckueiwt.supabase.co
# The SERVICE ROLE key, not the anon/public key — this grants full database
# access and must never be exposed to the frontend or committed to git.
# Find it in Supabase: Project Settings → API → service_role key.
SUPABASE_SERVICE_ROLE_KEY=

# Generate with: npm run hash-password -- "your-chosen-password"
PASSWORD_HASH=

# How long a login session lasts before you need to sign in again.
SESSION_TTL_HOURS=168

NODE_ENV=development
